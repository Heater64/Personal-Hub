[TEMPLATE]
# Variables VITE_* (cliente). Se embeben en el bundle — nunca pongas secretos aquí.
# Copia: cp .env.example .env  y rellena los valores reales (ver README §3).

# Supabase (Auth / Postgres / Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary (subida de multimedia; preset unsigned)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# ---------- Variables de SERVIDOR (solo .env local y Vercel, nunca en el repo) ----------
# Nada de este bloque se commitea: .env está en .gitignore y en Vercel va como
# variable sensible (Settings → Environment Variables).

# Supabase — servicio (api/*).
SUPABASE_SERVICE_ROLE_KEY=

# Web Push. VAPID_PUBLIC_KEY tiene que ser EXACTAMENTE la que hay en
# personal-hub/src/services/notifications.service.js y public/sw.js, y
# VAPID_PRIVATE_KEY la pareja de esa pública: una pública copiada mal rompe
# el alta de suscripción (subscribe() la rechaza) y una pareja mal formada
# rompe los envíos (el push service rechaza la firma).
#   Genera el par: npx web-push generate-vapid-keys
#   Valída los dos: npm run check:push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT: mailto: o https: de contacto (p. ej. mailto:tu@email.com)
VAPID_SUBJECT=

# Secreto del cron (/api/push?action=send). El MISMO valor en Vercel y en el
# secreto de Vault push_cron_secret (SUPABASE-SETUP.md §4).
# Sin él el cron diario responde 500 «Cron secret not configured».
CRON_SECRET=
