# Variables VITE_* (cliente). Se embeben en el bundle — nunca pongas secretos aquí.
# Copia: cp .env.example .env  y rellena los valores reales (ver README §3).

# Supabase (Auth / Postgres / Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary (subida de multimedia; preset unsigned)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
