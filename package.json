{
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.111.0",
    "cloudinary": "^2.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "playwright": "^1.59.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "name": "personal-hub",
  "version": "2.0.0",
  "description": "Tu lugar especial con sorpresas, juegos y fotos nuestras.",
  "main": "personal-hub/index.html",
  "scripts": {
    "dev": "npx vite personal-hub",
    "build": "npx vite build personal-hub",
    "preview": "npx vite preview personal-hub",
    "cap:add": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "npm run cap:sync && cap run android",
    "test": "node --test tests/prepush.test.js tests/notification-route.test.js tests/routes-registry.test.js tests/push-reminders.test.js tests/notification-prefs.test.js tests/admin-alerts.test.js tests/delivery-log.test.js tests/vapid-keys.test.js tests/push-key-rotation.test.js tests/announce.test.js tests/rls-hardening.test.js tests/stats-metrics.test.js",
    "check:push": "node scripts/check-push.js",
    "postinstall": "node -e \"try{require('fs').chmodSync('node_modules/.bin/vite',0o755)}catch(e){}\"",
    "lint": "eslint personal-hub/src tests",
    "format": "prettier --write \"personal-hub/src/**/*.{js,css,html,json,md}\" \"tests/**/*.{js,mjs}\" \"*.md\" \"*.json\" \"eslint.config.js\"",
    "format:check": "prettier --check \"personal-hub/src/**/*.{js,css,html,json,md}\" \"tests/**/*.{js,mjs}\" \"*.md\" \"*.json\" \"eslint.config.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heater64/Personal-Hub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Heater64/Personal-Hub/issues"
  },
  "homepage": "https://github.com/Heater64/Personal-Hub#readme"
}
