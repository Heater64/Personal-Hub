{
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "cloudinary": "^2.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "playwright": "^1.59.1",
    "prettier": "^3.9.9",
    "vite": "^8.1.5"
  },
  "name": "personal-hub",
  "version": "2.0.0",
  "description": "Tu lugar especial con sorpresas, juegos y fotos nuestras.",
  "main": "personal-hub/index.html",
  "scripts": {
    "dev": "npx vite personal-hub",
    "build": "npx vite build personal-hub",
    "preview": "npx vite preview personal-hub",
    "test": "node --test tests/prepush.test.js",
    "postinstall": "node -e \"try{require('fs').chmodSync('node_modules/.bin/vite',0o755)}catch(e){}\"",
    "lint": "eslint personal-hub/src tests",
    "format": "prettier --write \"personal-hub/src/**/*.{js,css,html,json,md}\" \"tests/**/*.{js,mjs}\" \"*.md\" \"*.json\" \"eslint.config.js\"",
    "format:check": "prettier --check \"personal-hub/src/**/*.{js,css,html,json,md}\" \"tests/**/*.{js,mjs}\" \"*.md\" \"*.json\" \"eslint.config.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heater64/Personal-Hub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Heater64/Personal-Hub/issues"
  },
  "homepage": "https://github.com/Heater64/Personal-Hub#readme"
}
