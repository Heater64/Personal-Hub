<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_countdown_description_rect"
    android:configure="com.heater64.personalhub.CountdownWidgetConfigActivity"
    android:initialLayout="@layout/widget_countdown_rect"
    android:minHeight="64dp"
    android:minResizeHeight="64dp"
    android:minResizeWidth="160dp"
    android:minWidth="180dp"
