<?xml version="1.0" encoding="utf-8"?>
<!-- Días juntos · 4×2

     Composición horizontal, no el grande con menos cosas: acento coral,
     número grande a la izquierda y las dos caras a la derecha. Debajo del
     número, el desglose («1 año y 4 meses») aporta algo que el total no dice. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_days_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_days_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- RemoteViews no permite View genérico; ImageView es una vista remota
         permitida y conserva la barra coral puramente decorativa. -->
    <ImageView
        android:layout_width="2dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_days_accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="@string/widget_days_label_short"
            android:textColor="@color/widget_coral"
            android:textSize="8sp"
            android:textStyle="bold"
        tools:text="DÍAS JUNTOS"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_days_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
        tools:text="512"/>

            <TextView
                android:id="@+id/widget_days_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="3dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_days_unit_short"
                android:textColor="@color/widget_coral"
                android:textSize="10sp"
        tools:text="días"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_days_breakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_days_empty"
            android:textColor="@color/widget_text_muted"
            android:textSize="8sp"
        tools:text="1 año y 4 meses"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_days_faces"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_days_me"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_days_face_ring"
            android:contentDescription="@string/widget_days_me"
            android:scaleType="centerInside"
        tools:src="@drawable/widget_days_face_empty"/>

        <ImageView
            android:id="@+id/widget_days_partner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="-10dp"
            android:background="@drawable/widget_days_face_ring"
            android:contentDescription="@string/widget_days_partner"
            android:scaleType="centerInside"
        tools:src="@drawable/widget_days_face_empty"/>
    </LinearLayout>

</LinearLayout>
