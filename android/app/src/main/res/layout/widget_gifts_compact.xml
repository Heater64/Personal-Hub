<?xml version="1.0" encoding="utf-8"?>
<!-- Sorpresas · 1×1

     Cuántas hay hoy y cuántas esperan. Sin decir qué son: eso es el regalo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_gifts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_gifts_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/widget_gifts_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_gifts_emoji"
        android:textSize="18sp"
        tools:text="🎁" />

    <TextView
        android:id="@+id/widget_gifts_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_value_placeholder"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="2" />

    <TextView
        android:id="@+id/widget_gifts_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_gifts_empty"
        android:textColor="@color/widget_rose"
        android:textSize="11sp"
        tools:text="sorpresas" />

</LinearLayout>
