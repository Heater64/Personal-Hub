<?xml version="1.0" encoding="utf-8"?>
<!-- Estado de ánimo · 4×2

     Misma composición horizontal que «días juntos»: barra coral, etiqueta y
     cuándo a la izquierda y el emoji, que es el dato, a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_mood_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mood_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- RemoteViews no permite View genérico; ImageView es una vista remota
         permitida y conserva la barra coral puramente decorativa. -->
    <ImageView
        android:layout_width="3dp"
        android:layout_height="54dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_days_accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_mood_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="@string/widget_mood_kicker_large"
            android:textColor="@color/widget_rose"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="ESTADO DE ÁNIMO" />

        <TextView
            android:id="@+id/widget_mood_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_mood_empty"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Muy feliz" />

        <TextView
            android:id="@+id/widget_mood_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_mood_hint"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp"
            tools:text="hoy" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_mood_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="—"
        android:textSize="44sp"
        tools:text="🥰" />

</LinearLayout>
