<?xml version="1.0" encoding="utf-8"?>
<!-- Distancia · 1×1

     Mismo patrón que «días juntos»: en una celda solo cabe el dato. La cifra
     con su etiqueta encima y, si no hay distancia, «abre la app». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_distance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_distance_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/widget_distance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="@string/widget_distance_kicker"
        android:textColor="@color/widget_coral_soft"
        android:textSize="7sp"
        android:textStyle="bold"
        tools:text="ESTÁIS A" />

    <TextView
        android:id="@+id/widget_distance_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:text="24,8 km" />

    <TextView
        android:id="@+id/widget_distance_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_distance_empty"
        android:textColor="@color/widget_text_muted"
        android:textSize="7sp"
        android:visibility="gone"
        tools:text="abre la app" />

</LinearLayout>
