<?xml version="1.0" encoding="utf-8"?>
<!-- Cuenta atrás · 4×3

     Apilada: «FALTAN», número grande con «días», el título de la fecha y el día
     concreto. Una sola lectura: cuánto queda y para qué. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_countdown_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_countdown_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:text="@string/widget_countdown_kicker"
        android:textColor="@color/widget_coral_soft"
        android:textSize="8sp"
        android:textStyle="bold"
        tools:text="FALTAN"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_countdown_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
        tools:text="23"/>

        <TextView
            android:id="@+id/widget_countdown_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="6dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_countdown_unit"
            android:textColor="@color/widget_rose"
            android:textSize="14sp"
        tools:text="días"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_countdown_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_countdown_empty"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Nuestro aniversario"/>

    <TextView
        android:id="@+id/widget_countdown_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        tools:text="3 jul 2026"/>

</LinearLayout>
