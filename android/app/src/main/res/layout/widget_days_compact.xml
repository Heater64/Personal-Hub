<?xml version="1.0" encoding="utf-8"?>
<!-- Días juntos, tamaño pequeño: sin fotos, solo el número. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_days_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_days_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_days_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_days_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_days_unit"
        android:textColor="#F0E2F2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_days_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_days_caption2"
        android:textColor="#D3C2D8"
        android:textSize="12sp" />

</LinearLayout>
