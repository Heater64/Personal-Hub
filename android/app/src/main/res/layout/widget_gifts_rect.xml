<?xml version="1.0" encoding="utf-8"?>
<!-- Sorpresas · 4×2

     Barra coral, «HOY» y el número con lo que queda por abrir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_gifts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_gifts_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:layout_width="3dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_days_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_gifts_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_gifts_kicker"
            android:textColor="@color/widget_coral_soft"
            android:textSize="8sp"
            android:textStyle="bold"
        tools:text="HOY"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_gifts_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
        tools:text="2"/>

            <TextView
                android:id="@+id/widget_gifts_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_gifts_unit"
                android:textColor="@color/widget_rose"
                android:textSize="10sp"
        tools:text="sorpresas"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_gifts_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp"
        tools:text="sorpresas"/>
    </LinearLayout>

</LinearLayout>
