<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_days_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_days_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_days_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_days_label"
        android:textColor="#E8E6E3"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_days_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="0"
        android:textColor="#E8735A"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_days_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_days_caption"
        android:textColor="#9A9490"
        android:textSize="11sp" />

</LinearLayout>
