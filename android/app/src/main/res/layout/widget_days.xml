<?xml version="1.0" encoding="utf-8"?>
<!-- Días juntos · 4×3

     Composición vertical: las caras arriba (la parte emotiva), el número en el
     centro y, debajo, el desglose. La línea de «datos antiguos» solo aparece
     cuando el paquete guardado tiene más de un día; si no, queda oculta y el
     contenido se centra solo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_days_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_days_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_days_faces"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_days_me"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_days_face_ring"
            android:contentDescription="@string/widget_days_me"
            android:scaleType="centerInside"
        tools:src="@drawable/widget_days_face_empty"/>

        <ImageView
            android:id="@+id/widget_days_partner"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-12dp"
            android:background="@drawable/widget_days_face_ring"
            android:contentDescription="@string/widget_days_partner"
            android:scaleType="centerInside"
        tools:src="@drawable/widget_days_face_empty"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_days_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:text="@string/widget_days_label_short"
        android:textColor="@color/widget_coral"
        android:textSize="9sp"
        android:textStyle="bold"
        tools:text="DÍAS JUNTOS"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_days_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold"
        tools:text="512"/>

        <TextView
            android:id="@+id/widget_days_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="6dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_days_unit_short"
            android:textColor="@color/widget_coral"
            android:textSize="14sp"
        tools:text="días"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_days_breakdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_days_empty"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        tools:text="1 año y 4 meses"/>

    <TextView
        android:id="@+id/widget_days_fresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_coral_soft"
        android:textSize="8sp"
        android:visibility="gone"
        tools:text="ahora mismo"/>

</LinearLayout>
