<?xml version="1.0" encoding="utf-8"?>
<!-- Ciclo · 3×1

     Barra coral y, a la izquierda, la fase, el día y cuánto falta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_cycle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_cycle_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- RemoteViews no permite View genérico; ImageView es una vista remota
         permitida y conserva la barra coral puramente decorativa. -->
    <ImageView
        android:layout_width="2dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_days_accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_cycle_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_cycle_kicker"
            android:textColor="@color/widget_coral_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="CICLO" />

        <TextView
            android:id="@+id/widget_cycle_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_cycle_empty"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Fase lútea" />

        <TextView
            android:id="@+id/widget_cycle_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_rose"
            android:textSize="11sp"
            tools:text="día 21 de ~28" />

        <TextView
            android:id="@+id/widget_cycle_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
            tools:text="próxima regla en 6 d · 24 nov" />
    </LinearLayout>

</LinearLayout>
