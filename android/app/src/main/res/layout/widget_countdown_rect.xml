<?xml version="1.0" encoding="utf-8"?>
<!-- Cuenta atrás · 3×1

     Horizontal: acento coral y, a la izquierda, título, número y fecha. Sin
     caras: aquí el dato es el día, no quién. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_countdown_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- RemoteViews no permite View genérico; ImageView es una vista remota
         permitida y conserva la barra coral puramente decorativa. -->
    <ImageView
        android:layout_width="2dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_days_accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_countdown_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_countdown_empty"
            android:textColor="@color/widget_coral_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Nuestro aniversario" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_countdown_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_value_placeholder"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="23" />

            <TextView
                android:id="@+id/widget_countdown_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="3dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_countdown_unit_short"
                android:textColor="@color/widget_rose"
                android:textSize="11sp"
                tools:text="días" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_countdown_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
            tools:text="3 jul 2026" />
    </LinearLayout>

</LinearLayout>
