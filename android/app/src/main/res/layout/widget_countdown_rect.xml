<?xml version="1.0" encoding="utf-8"?>
<!-- Cuenta atrás · 4×2

     Horizontal: acento coral y, a la izquierda, título, número y fecha. Sin
     caras: aquí el dato es el día, no quién. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_countdown_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:layout_width="3dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_days_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_countdown_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_countdown_empty"
            android:textColor="@color/widget_coral_soft"
            android:textSize="8sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_countdown_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_countdown_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_countdown_unit"
                android:textColor="@color/widget_rose"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_countdown_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp" />
    </LinearLayout>

</LinearLayout>
