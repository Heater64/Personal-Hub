<?xml version="1.0" encoding="utf-8"?>
<!-- Sorpresas · 4×3

     «HOY», emoji grande, número y qué hacer con ellas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_gifts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_gifts_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_gifts_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:text="@string/widget_gifts_kicker"
        android:textColor="@color/widget_coral_soft"
        android:textSize="8sp"
        android:textStyle="bold"
        tools:text="HOY"/>

    <TextView
        android:id="@+id/widget_gifts_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_gifts_emoji"
        android:textSize="30sp"
        tools:text="🎁"/>

    <TextView
        android:id="@+id/widget_gifts_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        tools:text="2"/>

    <TextView
        android:id="@+id/widget_gifts_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_gifts_empty"
        android:textColor="@color/widget_rose"
        android:textSize="10sp"
        tools:text="sorpresas"/>

    <TextView
        android:id="@+id/widget_gifts_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        tools:text="en el calendario"/>

</LinearLayout>
