<?xml version="1.0" encoding="utf-8"?>
<!-- Sorpresas · 4×2

     Misma composición horizontal que «días juntos»: barra coral, «HOY», el
     número y qué hacer, con el regalo a la derecha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_gifts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_gifts_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- RemoteViews no permite View genérico; ImageView es una vista remota
         permitida y conserva la barra coral puramente decorativa. -->
    <ImageView
        android:layout_width="3dp"
        android:layout_height="54dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_days_accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_gifts_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="@string/widget_gifts_kicker"
            android:textColor="@color/widget_coral_soft"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="HOY" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_gifts_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold"
                tools:text="2" />

            <TextView
                android:id="@+id/widget_gifts_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="5dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_gifts_unit"
                android:textColor="@color/widget_rose"
                android:textSize="12sp"
                tools:text="sorpresas" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_gifts_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_rose"
            android:textSize="9sp"
            tools:text="ya las abriste" />

        <TextView
            android:id="@+id/widget_gifts_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="8sp"
            tools:text="en el calendario" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_gifts_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_gifts_emoji"
        android:textSize="44sp"
        tools:text="🎁" />

</LinearLayout>
