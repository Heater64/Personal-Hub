<?xml version="1.0" encoding="utf-8"?>
<!-- Distancia · 4×2

     Composición horizontal: acento coral, cifra con su tiempo debajo y las dos
     caras a la derecha. Pensada para 110 dp de alto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_distance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_distance_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:layout_width="3dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_days_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_distance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="@string/widget_distance_kicker"
            android:textColor="@color/widget_coral_soft"
            android:textSize="8sp"
            android:textStyle="bold"
        tools:text="ESTÁIS A"/>

        <TextView
            android:id="@+id/widget_distance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
        tools:text="24,8 km"/>

        <TextView
            android:id="@+id/widget_distance_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_distance_empty"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp"
        tools:text="ahora mismo"/>

        <TextView
            android:id="@+id/widget_distance_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_rose"
            android:textSize="8sp"
            android:visibility="gone"
        tools:text="su móvil · 84 % · Wi-Fi"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_distance_faces"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_distance_me"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/widget_face_ring"
            android:contentDescription="@string/widget_days_me"
            android:scaleType="centerInside"
        tools:src="@drawable/widget_face_empty"/>

        <ImageView
            android:id="@+id/widget_distance_partner"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="-12dp"
            android:background="@drawable/widget_face_ring"
            android:contentDescription="@string/widget_days_partner"
            android:scaleType="centerInside"
        tools:src="@drawable/widget_face_empty"/>
    </LinearLayout>

</LinearLayout>
