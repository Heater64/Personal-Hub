<?xml version="1.0" encoding="utf-8"?>
<!-- Estado de ánimo · 1×1

     El emoji es el dato: grande y centrado, con la etiqueta debajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_mood_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mood_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/widget_mood_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_value_placeholder"
        android:textSize="26sp"
        tools:text="🥰" />

    <TextView
        android:id="@+id/widget_mood_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_mood_empty"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        tools:text="Muy feliz" />

    <TextView
        android:id="@+id/widget_mood_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_mood_hint"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        tools:text="hoy" />

</LinearLayout>
