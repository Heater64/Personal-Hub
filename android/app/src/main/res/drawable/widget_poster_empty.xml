<?xml version="1.0" encoding="utf-8"?>
<!-- Hueco del póster de una serie: cuadrado redondeado, no círculo, porque una
     portada recortada en círculo deja de reconocerse. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="#4A3A50" />
    <stroke
        android:width="1dp"
        android:color="#33F3C5D0" />
</shape>
