<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link de los widgets: personalhub://juntos abre la
                 pantalla del aniversario. Capacitor lo entrega como
                 appUrlOpen y la web navega a /juntos. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.heater64.personalhub" />
            </intent-filter>
        </activity>

        <!-- Contador de días juntos en la pantalla de inicio (widget de prueba). -->
        <!-- Widgets: exported=true es OBLIGATORIO. El launcher es otra app y es
             quien pide la lista y envía los APPWIDGET_UPDATE; con false no
             aparecen en el cajón de widgets. -->
        <receiver
            android:name=".DaysWidgetProvider"
            android:exported="true"
            android:label="@string/widget_days_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_days_info" />
        </receiver>

        <!-- Distancia entre los dos: lee la última que calculó la app. -->
        <receiver
            android:name=".DistanceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_distance_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
                        <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_distance_info" />
        </receiver>

        <!-- Versiones pequeñas: mismo diseño, otra talla mínima. -->
        <receiver
            android:name=".DaysCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_days_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_days_compact_info" />
        </receiver>

        <receiver
            android:name=".DistanceCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_distance_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_distance_compact_info" />
        </receiver>

        <!-- Estado del móvil en segundo plano. El tipo «location» es el que
             permite leer ubicaciones fuera de la app. -->
        <service
            android:name=".DeviceStatusService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Al reiniciar el móvil se retoma el seguimiento si estaba activo. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Mapa de la distancia. El plugin @capacitor/geolocation NO las declara
         en su propio manifiesto (está vacío), así que sin esto
         requestPermissions() devuelve «denegado» siempre y la distancia nunca
         funciona dentro de la app. ACCESS_COARSE basta para la distancia;
         la fina se pide porque el plugin la exige en su configuración. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Seguimiento del móvil: el servicio en primer plano mantiene ubicación,
         batería y red al día con la app cerrada. Android 10+ exige el permiso
         de ubicación «todo el tiempo» y Android 14+ declara el tipo de
         servicio; el aviso fijo es obligatorio. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
