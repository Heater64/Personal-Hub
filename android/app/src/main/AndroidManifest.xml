<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <service android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service android:name=".WidgetMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link de los widgets: personalhub://juntos abre la
                 pantalla del aniversario. Capacitor lo entrega como
                 appUrlOpen y la web navega a /juntos. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.heater64.personalhub" />
            </intent-filter>
        </activity>

        <!-- Contador de días juntos en la pantalla de inicio (widget de prueba). -->
        <!-- Widgets: exported=true es OBLIGATORIO. El launcher es otra app y es
             quien pide la lista y envía los APPWIDGET_UPDATE; con false no
             aparecen en el cajón de widgets. -->
        <receiver
            android:name=".DaysWidgetProvider"
            android:exported="true"
            android:label="@string/widget_days_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_days_info" />
        </receiver>

        <!-- Distancia entre los dos: lee la última que calculó la app. -->
        <receiver
            android:name=".DistanceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_distance_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
                        <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_distance_info" />
        </receiver>

        <!-- Distancia, versión rectangular (4×2). -->
        <receiver
            android:name=".DistanceRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_distance_description_rect">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_distance_rect_info" />
        </receiver>

        <!-- Días juntos, versión rectangular (4×2): mismo dato, otra
             composición. -->
        <receiver
            android:name=".DaysRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_days_description_rect">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_days_rect_info" />
        </receiver>

        <!-- Versiones pequeñas: mismo diseño, otra talla mínima. -->
        <receiver
            android:name=".DaysCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_days_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_days_compact_info" />
        </receiver>

        <receiver
            android:name=".DistanceCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_distance_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_distance_compact_info" />
        </receiver>

        <!-- Cuenta atrás para la próxima fecha del panel. -->
        <receiver
            android:name=".CountdownWidgetProvider"
            android:exported="true"
            android:label="@string/widget_countdown_description_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>

        <receiver
            android:name=".CountdownRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_countdown_description_rect">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_rect_info" />
        </receiver>

        <receiver
            android:name=".CountdownCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_countdown_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_compact_info" />
        </receiver>

        <!-- Estado de ánimo de hoy. -->
        <receiver
            android:name=".MoodWidgetProvider"
            android:exported="true"
            android:label="@string/widget_mood_description_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mood_info" />
        </receiver>

        <receiver
            android:name=".MoodRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_mood_description_rect">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mood_rect_info" />
        </receiver>

        <receiver
            android:name=".MoodCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_mood_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mood_compact_info" />
        </receiver>

        <!-- Estado del móvil en segundo plano. El tipo «location» es el que
             permite leer ubicaciones fuera de la app. -->
        <service
            android:name=".DeviceStatusService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Elegir qué fechas enseña la cuenta atrás. Android la abre al
             colocar el widget (android:configure en su ficha) con el id de
             la instancia; sin exportar, el launcher no puede abrirla. -->
        <activity
            android:name=".CountdownWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_countdown_config_title"
            android:theme="@style/WidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Ciclo -->
        <receiver
            android:name=".CycleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_cycle_description_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cycle_info" />
        </receiver>
        <receiver
            android:name=".CycleRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_cycle_description_rect">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cycle_rect_info" />
        </receiver>
        <receiver
            android:name=".CycleCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_cycle_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cycle_compact_info" />
        </receiver>

        <!-- Seguir viendo -->
        <receiver
            android:name=".WatchingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_watching_description_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_watching_info" />
        </receiver>
        <receiver
            android:name=".WatchingRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_watching_description_rect">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_watching_rect_info" />
        </receiver>
        <receiver
            android:name=".WatchingCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_watching_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_watching_compact_info" />
        </receiver>

        <!-- Sorpresas -->
        <receiver
            android:name=".GiftsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_gifts_description_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gifts_info" />
        </receiver>
        <receiver
            android:name=".GiftsRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_gifts_description_rect">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gifts_rect_info" />
        </receiver>
        <receiver
            android:name=".GiftsCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_gifts_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gifts_compact_info" />
        </receiver>

        <!-- Cambio de día/hora/huso/idioma: los widgets recalculan «hoy»,
             «ayer» y los días que faltan sin esperar a que se abra la app.
             exported=false: solo el sistema puede enviar estos avisos. -->
        <receiver
            android:name=".WidgetDayChangeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Al reiniciar el móvil se retoma el seguimiento si estaba activo. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Fase Pro: razón del día, Open When pendiente y racha -->
        <receiver
            android:name=".ReasonRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_reason_description_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reason_info" />
        </receiver>
        <receiver
            android:name=".ReasonCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_reason_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reason_compact_info" />
        </receiver>
        <receiver
            android:name=".OpenWhenRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_openwhen_description_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_openwhen_info" />
        </receiver>
        <receiver
            android:name=".OpenWhenCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_openwhen_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_openwhen_compact_info" />
        </receiver>
        <receiver
            android:name=".StreakRectWidgetProvider"
            android:exported="true"
            android:label="@string/widget_streak_description_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>
        <receiver
            android:name=".StreakCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_streak_description_compact">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_compact_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Mapa de la distancia. El plugin @capacitor/geolocation NO las declara
         en su propio manifiesto (está vacío), así que sin esto
         requestPermissions() devuelve «denegado» siempre y la distancia nunca
         funciona dentro de la app. ACCESS_COARSE basta para la distancia;
         la fina se pide porque el plugin la exige en su configuración. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Seguimiento del móvil: el servicio en primer plano mantiene ubicación,
         batería y red al día con la app cerrada. Android 10+ exige el permiso
         de ubicación «todo el tiempo» y Android 14+ declara el tipo de
         servicio; el aviso fijo es obligatorio. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
